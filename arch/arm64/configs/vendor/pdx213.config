# Delta on top of aosp_lena_pdx213_defconfig, which is imported from SODP
# unchanged.  Keep this file small and say why for every line.

# genksyms cannot expand "union __packed gsi_channel_scratch" passed by value,
# so gsi_write_channel_scratch gets no CRC.  ld.lld then refuses the vmlinux
# link outright:
#   WARNING: EXPORT symbol "gsi_write_channel_scratch" [vmlinux] version
#            generation failed, symbol will not be versioned.
#   ld.lld: error: relocation R_AARCH64_ABS32 cannot be used against symbol
#           '__crc_gsi_write_channel_scratch'
# GNU ld resolves the undefined CRC to zero and says nothing, which is why the
# same tree builds with the 4.9 binutils.  Symbol versioning buys nothing here
# - every module ships with the kernel that built it - so drop it rather than
# patch CLO's header.
# CONFIG_MODVERSIONS is not set

# The defconfig signs every module with SHA512, but the sign-file the platform
# build produces is linked against BoringSSL, which only does SHA1:
#   sign-file: OpenSSL 1.1.1 (compatible; BoringSSL) only supports SHA1 signing
# A module that fails to sign is never installed, and the build then dies in
# depmod with "kernel module(s) need unknown symbol(s)".
# CONFIG_MODULE_SIG_FORCE is off, so unsigned modules load fine.
# CONFIG_MODULE_SIG_ALL is not set

# Huaqin's hardware_info, which lagoon.dtsi already includes a node for.
# Sony's drivers - the touchscreen, NFC, fuel gauge, camera, display, the
# speaker PAs and the fingerprint sensor - all call get_hardware_info_data()
# to register what they found, so this has to be in before any of them.
CONFIG_HQ_HARDWARE_INFO=y

# The Egis ET613 fingerprint sensor.  lena's device tree describes it as
# egistec_fingerprint / compatible = "egistec,et613", and libRbsFlow opens
# the /dev/esfp0 this driver creates.  Built in rather than as a module -
# nothing modprobes it, the HAL just opens the node.
CONFIG_FP_ET613=y

# The NXP SN1x0 NFC controller, as the shipping firmware describes it.
# Modules rather than built in: device_sony_sm6350-common's init.nfc.rc
# modprobes p73 and sn1x0 from /vendor/lib/modules at early-init, the same
# way the stock init.nfc.rc does.
#
# CONFIG_NFC - the kernel's own NCI stack - stays off, as it is on stock.
# libnfc-nci speaks NCI from user space and these drivers are plain
# chardevs, so they hang off drivers/nfc/Makefile without it.
CONFIG_NFC_SN1X0_DEVICES=m
CONFIG_NXP_P73_DEVICES=m
